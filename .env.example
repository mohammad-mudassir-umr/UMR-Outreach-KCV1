# ── Core ────────────────────────────────────────────────────────────────────
DRY_RUN=true
IDENTITY_NAME=Adam
BRAND_NAME=Your Agency
FORWARD_EMAIL=your-real@email.com

# ── AI provider cascade (priority order) ─────────────────────────────────────
AI_PROVIDERS=groq,openrouter,agnes,poixe
GROQ_API_KEYS=your-groq-key
OPENROUTER_API_KEYS=your-openrouter-key
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=minimax/minimax-m3:free

# ── Gmail sending (SMTP + app password, NOT the OAuth Gmail API) ────────────

# ── Email verification ────────────────────────────────────────────────────────
# MX check is free/unlimited and always runs. Verifalia is optional, capped.
VERIFALIA_API_KEY=
VERIFALIA_DAILY_LIMIT=25

# ── Twilio — internal hot-lead SMS alert only ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ALERT_NUMBER=

# ── Global campaign safety ────────────────────────────────────────────────────
GLOBAL_DAILY_MAX=1000
DEFAULT_ACCOUNT_DAILY_LIMIT=5
SENDING_STRATEGY=auto
# Internal conservative SMTP pacing. Account-level limits are configured in
# the dashboard; this is intentionally not a duplicate UI setting.
SEND_INTERVAL_SECONDS=60
FOLLOWUP_AFTER_DAYS=3
MAX_FOLLOWUPS=1
MAX_THREAD_EXCHANGES=2
SKIP_OUTSIDE_BUSINESS_HOURS=true

# ── Paths ──────────────────────────────────────────────────────────────────────
LEADS_CSV=data/leads.csv
SENT_LOG_CSV=data/sent_log.csv
QUARANTINE_CSV=data/quarantine.csv
TEMPLATES_FILE=templates/templates.json
STATE_DIR=state
# Optional additional AI providers (OpenAI-compatible where noted)
AGNES_API_KEYS=
POIXE_API_KEYS=
AGNES_MODEL=agnes-2.5-flash
POIXE_MODEL=deepseek-chat:free

# Bounded parallel pipeline controls
AI_WORKER_COUNT=8
AI_PROVIDER_CONCURRENCY=2
SEND_WORKER_COUNT=8
PIPELINE_QUEUE_SIZE=32


# ── Observability (optional; never store secrets in source control) ─────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local

